# Настройки портативного голосового клиента (формат KEY=VALUE)
# Скопируйте в client.env и подставьте адрес вашего сервера.

# Адрес сервера транскрибации (обязательно проверьте IP вашей машины с сервером)
VOICE_URL=http://192.168.130.155:8010

# Какой API использовать: native (родной /transcribe) или openai (/v1/audio/transcriptions)
VOICE_API=native

# Микрофон: фрагмент имени (без учёта регистра) или индекс из --list-devices.
# Оставьте пустым для автоматического выбора.
VOICE_DEVICE=

# Комбинация клавиш старт/стоп записи (синтаксис pynput)
VOICE_HOTKEY=<ctrl>+<alt>+z

# 1 = вставлять текст в активное окно (Ctrl+V), 0 = только буфер обмена
VOICE_PASTE=1

# 1 = нажимать Enter после вставки (сразу отправить)
VOICE_SEND_ENTER=0
